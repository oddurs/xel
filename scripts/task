#!/bin/sh
# The only interface CI, git hooks, and scripts/agent use to talk to the toolchains.
set -eu

cd "$(dirname "$0")/.."

SWIFT_SOURCES="app/Package.swift app/Sources"

# Generates the Swift bindings for the engine from the built static library. SwiftPM
# needs them laid out as a C module (header and module map) and a Swift target.
bindings() {
    out=app/Generated
    tmp=$out/.uniffi
    rm -rf "$out"
    mkdir -p "$tmp" "$out/xel_ffiFFI" "$out/XelEngine"
    cargo run --quiet --locked -p uniffi-bindgen -- generate \
        --library target/debug/libxel_ffi.a --language swift --out-dir "$tmp"
    mv "$tmp/xel_ffiFFI.h" "$out/xel_ffiFFI/"
    mv "$tmp/xel_ffiFFI.modulemap" "$out/xel_ffiFFI/module.modulemap"
    mv "$tmp/xel_ffi.swift" "$out/XelEngine/"
    rm -rf "$tmp"
}

swift_fmt_check() {
    # swift-format has no --check mode; diff each file against its formatted output.
    drift=0
    for f in $(find $SWIFT_SOURCES -name '*.swift'); do
        if ! swift format "$f" | diff -q "$f" - >/dev/null; then
            echo "needs formatting: $f" >&2
            drift=1
        fi
    done
    return "$drift"
}

run() {
    case "$1" in
        fmt)
            cargo fmt --all
            swift format --in-place --recursive $SWIFT_SOURCES
            ;;
        fmt:check)
            cargo fmt --all --check
            swift_fmt_check
            ;;
        lint)
            cargo clippy --workspace --all-targets --locked -- -D warnings
            swift format lint --strict --recursive $SWIFT_SOURCES
            ;;
        test)
            # The Swift app has no tests yet; XCTest needs full Xcode, so Swift tests
            # arrive with the first app logic worth testing.
            cargo test --workspace --locked
            ;;
        build)
            cargo build --workspace --locked
            bindings
            swift build --package-path app -Xswiftc -warnings-as-errors
            ;;
        check)
            run fmt:check
            run lint
            run test
            run build
            ;;
        *)
            echo "usage: scripts/task {fmt|fmt:check|lint|test|build|check}" >&2
            exit 2
            ;;
    esac
}

[ $# -eq 1 ] || run usage
run "$1"

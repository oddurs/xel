#!/bin/sh
# The only interface CI, git hooks, and scripts/agent use to talk to the toolchains.
set -eu

cd "$(dirname "$0")/.."

SWIFT_SOURCES="app/Package.swift app/Sources"

# Cargo's target directory, honouring CARGO_TARGET_DIR.
cargo_target_dir() {
    cargo metadata --format-version 1 --no-deps |
        sed -n 's/.*"target_directory":"\([^"]*\)".*/\1/p'
}

# The build profile: XEL_PROFILE=release for release builds, debug otherwise.
profile() {
    echo "${XEL_PROFILE:-debug}"
}

# Where cargo writes the host build of the engine's static library.
engine_lib_dir() {
    echo "$(cargo_target_dir)/$(profile)"
}

# Generates the Swift bindings for the engine from the built static library. SwiftPM
# needs them laid out as a C module (header and module map) and a Swift target. Files are
# replaced only when they change, so SwiftPM does not recompile them on every build.
bindings() {
    lib=$(engine_lib_dir)/libxel_ffi.a
    out=app/Generated
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/xel-bindings.XXXXXX")
    cargo run --quiet --locked --manifest-path tools/uniffi-bindgen/Cargo.toml -- \
        generate --library "$lib" --language swift --out-dir "$tmp"
    mkdir -p "$out/xel_ffiFFI" "$out/XelEngine"
    place() {
        if ! cmp -s "$1" "$2"; then
            cp "$1" "$2"
        fi
    }
    place "$tmp/xel_ffiFFI.h" "$out/xel_ffiFFI/xel_ffiFFI.h"
    place "$tmp/xel_ffiFFI.modulemap" "$out/xel_ffiFFI/module.modulemap"
    place "$tmp/xel_ffi.swift" "$out/XelEngine/xel_ffi.swift"
    rm -rf "$tmp"
}

swift_fmt_check() {
    # swift-format has no --check mode; diff each file against its formatted output.
    drift=0
    for f in $(find $SWIFT_SOURCES -name '*.swift'); do
        if ! swift format "$f" | diff -q "$f" - >/dev/null; then
            echo "needs formatting: $f" >&2
            drift=1
        fi
    done
    return "$drift"
}

run() {
    case "$1" in
        fmt)
            cargo fmt --all
            swift format --in-place --recursive $SWIFT_SOURCES
            ;;
        fmt:check)
            cargo fmt --all --check
            swift_fmt_check
            ;;
        lint)
            cargo clippy --workspace --all-targets --locked -- -D warnings
            swift format lint --strict --recursive $SWIFT_SOURCES
            ;;
        test)
            # The Swift app has no tests yet; XCTest needs full Xcode, so Swift tests
            # arrive with the first app logic worth testing.
            cargo test --workspace --locked
            ;;
        build)
            profile_flag=""
            if [ "$(profile)" = release ]; then
                profile_flag="--release"
            fi
            cargo build --workspace --locked $profile_flag
            bindings
            lib_dir=$(engine_lib_dir)
            arch_flags=""
            # XEL_UNIVERSAL=1 builds for Apple silicon and Intel and links a universal app.
            # SwiftPM needs Xcode's build system for more than one architecture, so local
            # builds with only the Command Line Tools stay host-only.
            if [ "${XEL_UNIVERSAL:-0}" = 1 ]; then
                target=$(cargo_target_dir)
                lib_dir=$target/universal/$(profile)
                mkdir -p "$lib_dir"
                for triple in aarch64-apple-darwin x86_64-apple-darwin; do
                    cargo build -p xel-ffi --locked $profile_flag --target "$triple"
                done
                lipo -create \
                    "$target/aarch64-apple-darwin/$(profile)/libxel_ffi.a" \
                    "$target/x86_64-apple-darwin/$(profile)/libxel_ffi.a" \
                    -output "$lib_dir/libxel_ffi.a"
                arch_flags="--arch arm64 --arch x86_64"
            fi
            XEL_ENGINE_LIB_DIR=$lib_dir \
                swift build --package-path app -Xswiftc -warnings-as-errors \
                -c "$(profile)" $arch_flags
            ;;
        check)
            run fmt:check
            run lint
            run test
            run build
            ;;
        *)
            echo "usage: scripts/task {fmt|fmt:check|lint|test|build|check}" >&2
            exit 2
            ;;
    esac
}

[ $# -eq 1 ] || run usage
run "$1"

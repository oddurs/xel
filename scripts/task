#!/bin/sh
# The only interface CI, git hooks, and scripts/agent use to talk to the toolchains.
set -eu

cd "$(dirname "$0")/.."

SWIFT_SOURCES="app/Package.swift app/Sources app/Tests"

# Cargo's target directory, honouring CARGO_TARGET_DIR.
cargo_target_dir() {
    cargo metadata --format-version 1 --no-deps |
        sed -n 's/.*"target_directory":"\([^"]*\)".*/\1/p'
}

# The build profile: XEL_PROFILE=release for release builds, debug otherwise.
profile() {
    case "${XEL_PROFILE:-debug}" in
        debug | release) echo "${XEL_PROFILE:-debug}" ;;
        *)
            echo "task: XEL_PROFILE must be debug or release, not '$XEL_PROFILE'" >&2
            exit 2
            ;;
    esac
}

# Whether to build for Apple silicon and Intel: XEL_UNIVERSAL=1.
universal() {
    case "${XEL_UNIVERSAL:-0}" in
        0) return 1 ;;
        1) return 0 ;;
        *)
            echo "task: XEL_UNIVERSAL must be 0 or 1, not '$XEL_UNIVERSAL'" >&2
            exit 2
            ;;
    esac
}

# Copies $1 over $2 only if they differ, so unchanged outputs keep their timestamps.
place() {
    if ! cmp -s "$1" "$2"; then
        cp "$1" "$2"
    fi
}

# Generates the Swift bindings for the engine from the static library at $1. SwiftPM
# needs them laid out as a C module (header and module map) and a Swift target. Files are
# replaced only when they change, so SwiftPM does not recompile them on every build.
bindings() {
    out=app/Generated
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/xel-bindings.XXXXXX")
    cargo run --quiet --locked --manifest-path tools/uniffi-bindgen/Cargo.toml -- \
        generate --library "$1" --language swift --out-dir "$tmp"
    mkdir -p "$out/xel_ffiFFI" "$out/XelEngine"
    place "$tmp/xel_ffiFFI.h" "$out/xel_ffiFFI/xel_ffiFFI.h"
    place "$tmp/xel_ffiFFI.modulemap" "$out/xel_ffiFFI/module.modulemap"
    place "$tmp/xel_ffi.swift" "$out/XelEngine/xel_ffi.swift"
    rm -rf "$tmp"
}

# Builds the engine for this Mac and its Swift bindings, and sets lib_dir to the
# library's directory.
host_engine() {
    profile_flag=""
    if [ "$(profile)" = release ]; then
        profile_flag="--release"
    fi
    cargo build --workspace --locked $profile_flag
    lib_dir=$(cargo_target_dir)/$(profile)
    bindings "$lib_dir/libxel_ffi.a"
}

# Removes the Swift binary at $1 when the engine library in $lib_dir is newer.
relink_if_stale() {
    if [ "$lib_dir/libxel_ffi.a" -nt "$1" ]; then
        rm -f "$1"
    fi
}

# Runs the Swift tests against the engine built for this Mac.
swift_test() {
    host_engine
    prof=$(profile)
    # Its own build directory: the test flags differ from the app's, and sharing one would
    # make each rebuild everything the other built.
    scratch=app/.build-tests
    relink_if_stale "$(swift build --package-path app --scratch-path "$scratch" -c "$prof" --show-bin-path)/XelPackageTests.xctest/Contents/MacOS/XelPackageTests"
    # Xcode finds Swift Testing itself; the Command Line Tools ship it outside the default
    # search paths.
    developer=$(xcode-select -p)
    frameworks=$developer/Library/Developer/Frameworks
    set --
    if [ -d "$frameworks/Testing.framework" ]; then
        set -- -Xswiftc -F -Xswiftc "$frameworks" -Xlinker -F -Xlinker "$frameworks" \
            -Xlinker -rpath -Xlinker "$frameworks" \
            -Xlinker -rpath -Xlinker "$developer/Library/Developer/usr/lib"
    fi
    XEL_ENGINE_LIB_DIR=$lib_dir \
        swift test --package-path app --scratch-path "$scratch" -Xswiftc -warnings-as-errors \
        -c "$prof" "$@"
}

# Builds the engine, the bindings, and the Swift app.
build() {
    target=$(cargo_target_dir)
    prof=$(profile)
    profile_flag=""
    if [ "$prof" = release ]; then
        profile_flag="--release"
    fi
    if universal; then
        # SwiftPM needs Xcode's build system for more than one architecture, so this
        # works where Xcode is installed (CI), not with the Command Line Tools alone.
        rustup target add aarch64-apple-darwin x86_64-apple-darwin >/dev/null
        for triple in aarch64-apple-darwin x86_64-apple-darwin; do
            cargo build -p xel-ffi --locked $profile_flag --target "$triple"
        done
        lib_dir=$target/universal/$prof
        mkdir -p "$lib_dir"
        fat=$(mktemp "${TMPDIR:-/tmp}/xel-universal.XXXXXX")
        lipo -create \
            "$target/aarch64-apple-darwin/$prof/libxel_ffi.a" \
            "$target/x86_64-apple-darwin/$prof/libxel_ffi.a" \
            -output "$fat"
        place "$fat" "$lib_dir/libxel_ffi.a"
        rm -f "$fat"
        bindings "$target/aarch64-apple-darwin/$prof/libxel_ffi.a"
        set -- --arch arm64 --arch x86_64
    else
        host_engine
        set --
    fi
    # SwiftPM does not track the static library as a link input; when the engine is newer
    # than the app binary, remove the binary so SwiftPM links it again.
    bin=$(swift build --package-path app -c "$prof" "$@" --show-bin-path)/Xel
    relink_if_stale "$bin"
    XEL_ENGINE_LIB_DIR=$lib_dir \
        swift build --package-path app -Xswiftc -warnings-as-errors -c "$prof" "$@"
    if universal; then
        lipo "$bin" -verify_arch arm64 x86_64
    fi
    bundle "$bin"
}

# Assembles build/Xel.app around the app binary at $1: macOS treats a bare executable as
# a background tool, and only a bundle can declare the .xel document type. Signed ad hoc
# so it runs locally; Developer ID signing and notarization are the release's job. An
# unchanged binary and plist leave the bundle, and its signature, alone.
bundle() {
    app=build/Xel.app
    plist=$(mktemp "${TMPDIR:-/tmp}/xel-plist.XXXXXX")
    cp app/Bundle/Info.plist "$plist"
    version=$(sed -n 's/^version = "\(.*\)"/\1/p' crates/ffi/Cargo.toml | head -n 1)
    plutil -replace CFBundleShortVersionString -string "$version" "$plist"
    plutil -replace CFBundleVersion -string "$(git rev-list --count HEAD)" "$plist"
    plutil -lint -s "$plist"
    # Signing rewrites the binary inside the bundle, so compare the unsigned inputs
    # against the last ones bundled, kept beside the bundle.
    inputs=build/.bundle-inputs
    mkdir -p "$app/Contents/MacOS" "$inputs"
    if ! cmp -s "$1" "$inputs/Xel" || ! cmp -s "$plist" "$inputs/Info.plist"; then
        cp "$1" "$inputs/Xel"
        cp "$plist" "$inputs/Info.plist"
        cp "$1" "$app/Contents/MacOS/Xel"
        cp "$plist" "$app/Contents/Info.plist"
        codesign --force --sign - "$app"
    fi
    rm -f "$plist"
    executable=$(plutil -extract CFBundleExecutable raw "$app/Contents/Info.plist")
    if [ ! -x "$app/Contents/MacOS/$executable" ]; then
        echo "task: Info.plist names $executable, which is not in the bundle" >&2
        exit 1
    fi
    codesign --verify --strict "$app"
}

swift_fmt_check() {
    # swift-format has no --check mode; diff each file against its formatted output.
    drift=0
    for f in $(find $SWIFT_SOURCES -name '*.swift'); do
        if ! swift format "$f" | diff -q "$f" - >/dev/null; then
            echo "needs formatting: $f" >&2
            drift=1
        fi
    done
    return "$drift"
}

run() {
    case "$1" in
        fmt)
            cargo fmt --all
            swift format --in-place --recursive $SWIFT_SOURCES
            ;;
        fmt:check)
            cargo fmt --all --check
            swift_fmt_check
            ;;
        lint)
            cargo clippy --workspace --all-targets --locked -- -D warnings
            swift format lint --strict --recursive $SWIFT_SOURCES
            ;;
        test)
            cargo test --workspace --locked
            swift_test
            ;;
        build)
            build
            ;;
        check)
            run fmt:check
            run lint
            run test
            run build
            ;;
        *)
            echo "usage: scripts/task {fmt|fmt:check|lint|test|build|check}" >&2
            exit 2
            ;;
    esac
}

[ $# -eq 1 ] || run usage
run "$1"
